# ============================================================================
# Phlio Flutter client — configuration reference
# ============================================================================
# Flutter has no built-in `.env` file loader, so this file is NOT read at
# runtime — it documents the `--dart-define` flags `lib/app/config/app_config.dart`
# reads via `String.fromEnvironment`/`bool.fromEnvironment`, so every
# available override lives in one place, the same way a real `.env` would.
#
# Usage: translate each line below into a --dart-define flag, e.g.
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8000/api/v1
#
# Multiple flags: repeat --dart-define per flag, or use a JSON file with
# `--dart-define-from-file=dart_defines.json` (see Flutter's docs).
# ============================================================================

# The backend's API base URL, including the /api/v1 prefix.
#
# Defaults to http://localhost:8000/api/v1, which works for: iOS
# simulators, desktop (macOS/Linux/Windows), and `flutter run -d chrome`.
#
# Override for:
#   Android emulator  -> http://10.0.2.2:8000/api/v1   (10.0.2.2 reaches
#                         the host machine's localhost from the emulator)
#   Physical device    -> http://<your-machine-LAN-IP>:8000/api/v1
#   Deployed backend   -> https://api.phlio.app/api/v1
API_BASE_URL=http://localhost:8000/api/v1

# Whether the API client logs one line per HTTP request (method, path,
# status, duration) via lib/core/logging/app_logger.dart. Defaults to true
# — set to false for a quieter console during, e.g., a demo recording.
ENABLE_REQUEST_LOGGING=true
