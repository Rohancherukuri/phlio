<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch screen: Phlio's dark backdrop with the P mark centred,
     shown until Flutter draws its first frame (then the Foxy splash). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="#FF06060A" />
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
