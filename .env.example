# Environment variables read by docker-compose.yml at the repository root.
# Copy to .env (same directory as docker-compose.yml) and adjust.
#
# For backend-specific configuration when running `uv run uvicorn` directly
# (without Docker), see backend/.env.example instead.

DATABASE_BACKEND=memory
JWT_SECRET=dev-only-change-me-dev-only-change-me
ANTHROPIC_API_KEY=
CORS_ALLOW_ORIGINS=http://localhost:3000
