# ============================================================================
# Phlio Backend — environment configuration
# ============================================================================
# Copy this file to `.env` in the same directory (`backend/.env`) and adjust
# as needed. `.env` is git-ignored — never commit real secrets.
#
# Every variable here has a safe-for-local-dev default baked into
# `app/config.py::Settings`, so the backend runs with ZERO of these set.
# This file exists so you can see every knob in one place and override
# exactly the ones you need.
# ============================================================================

# ---- General --------------------------------------------------------------
# development | testing | staging | production
APP_ENV=development
DEBUG=true

# ---- Persistence ------------------------------------------------------------
# "memory"  — seeded in-process repositories. Zero setup, resets on restart.
#             Default; used in local dev and the test suite.
# "surreal" — production-shaped repositories backed by a real SurrealDB
#             instance. Point SURREAL_* below at it (see docker-compose.yml
#             at the repo root: `docker compose --profile full up`).
DATABASE_BACKEND=memory

SURREAL_URL=ws://localhost:8001/rpc
SURREAL_NAMESPACE=phlio
SURREAL_DATABASE=phlio
SURREAL_USER=root
SURREAL_PASSWORD=root

# Reserved for the caching/session/rate-limit layer described in
# Phlio_Final_Product_Blueprint.md section 25 ("Redis"). Not yet called by
# any code path in this build stage — declared here so wiring it up later
# is a one-file change, not a new env var to invent.
REDIS_URL=redis://localhost:6379/0

# ---- Auth -------------------------------------------------------------------
# Symmetric secret used to sign access/refresh JWTs. Generate a real one
# with `openssl rand -hex 32` before deploying anywhere real — the default
# below is intentionally obvious/unsafe so it's never mistaken for a real
# secret.
JWT_SECRET=dev-only-change-me-dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Phlio Agent --------------------------------------------------------------
# Optional. When set, the Phlio Agent uses Claude to write warmer plan
# summaries. When absent, the agent transparently falls back to the
# deterministic rule-based planner (app/domains/agent/planner.py) — the
# agent's actual plan *contents* always come from real Phlio data either
# way, never from the model. See that module's docstring for why.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Phlio Core engine (Rust) -------------------------------------------------
# Path to the compiled phlio-core CLI binary (see /phlio_core), resolved
# relative to backend/. Falls back automatically to an equivalent
# pure-Python implementation if the binary is missing — see
# app/infrastructure/core_engine/client.py.
CORE_ENGINE_BINARY_PATH=../phlio_core/target/release/phlio-core

# ---- Logging ------------------------------------------------------------------
# See Phlio_Final_Product_Blueprint.md section 38 ("Observability").
#
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
#   DEBUG shows per-request domain-service detail (e.g. every like toggle);
#   INFO (the default) shows one line per notable event (posts created,
#   logins, plans built) plus one access-log line per request.
#
# LOG_FORMAT: text | json
#   "text" — human-readable, one line per record. Best for a local terminal.
#   "json" — one JSON object per line. Best for a log aggregator (CloudWatch,
#            Loki, Datadog...) in staging/production — set this in your
#            deployment environment, not here.
LOG_LEVEL=INFO
LOG_FORMAT=text

# ---- CORS -----------------------------------------------------------------------
# Comma-separated list of origins the browser/app is allowed to call the API
# from. Include your Flutter web dev server's origin if you run `flutter run
# -d chrome` (defaults below cover the two most common local dev ports).
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
