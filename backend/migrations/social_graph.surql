-- Phlio Social Graph v1. Typed core tables; FastAPI is the only client gateway.
DEFINE TABLE IF NOT EXISTS user SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS username ON user TYPE string;
DEFINE FIELD IF NOT EXISTS full_name ON user TYPE string;
DEFINE FIELD IF NOT EXISTS email ON user TYPE string;
DEFINE FIELD IF NOT EXISTS hashed_password ON user TYPE string;
DEFINE FIELD IF NOT EXISTS avatar_url ON user TYPE option<string>;
DEFINE FIELD IF NOT EXISTS bio ON user TYPE string;
DEFINE FIELD IF NOT EXISTS interests ON user TYPE array<string>;
DEFINE FIELD IF NOT EXISTS created_at ON user TYPE datetime;
DEFINE FIELD IF NOT EXISTS is_verified ON user TYPE bool;
DEFINE FIELD IF NOT EXISTS date_of_birth ON user TYPE option<string>;
DEFINE FIELD IF NOT EXISTS phone_number ON user TYPE option<string>;
DEFINE FIELD IF NOT EXISTS is_creator ON user TYPE option<bool>;
DEFINE FIELD IF NOT EXISTS is_test_user ON user TYPE option<bool>;
DEFINE TABLE IF NOT EXISTS phlio_object SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS object_type ON phlio_object TYPE string;
DEFINE FIELD IF NOT EXISTS platform ON phlio_object TYPE string;
DEFINE FIELD IF NOT EXISTS domain_ref ON phlio_object TYPE string;
DEFINE FIELD IF NOT EXISTS owner ON phlio_object TYPE string;
DEFINE FIELD IF NOT EXISTS title ON phlio_object TYPE string;
DEFINE FIELD IF NOT EXISTS state ON phlio_object TYPE string;
DEFINE FIELD IF NOT EXISTS audience ON phlio_object TYPE string;
DEFINE FIELD IF NOT EXISTS room_id ON phlio_object TYPE option<string>;
DEFINE FIELD IF NOT EXISTS parent_id ON phlio_object TYPE option<string>;
DEFINE FIELD IF NOT EXISTS created_at ON phlio_object TYPE string;
DEFINE TABLE IF NOT EXISTS privacy_policy SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS owner ON privacy_policy TYPE string;
DEFINE FIELD IF NOT EXISTS platform ON privacy_policy TYPE string;
DEFINE FIELD IF NOT EXISTS object_type ON privacy_policy TYPE string;
DEFINE FIELD IF NOT EXISTS verb ON privacy_policy TYPE string;
DEFINE FIELD IF NOT EXISTS audience ON privacy_policy TYPE string;
DEFINE FIELD IF NOT EXISTS identity_mode ON privacy_policy TYPE string;
DEFINE FIELD IF NOT EXISTS foxy_access ON privacy_policy TYPE string;
DEFINE FIELD IF NOT EXISTS selected_users ON privacy_policy TYPE array<string>;
DEFINE FIELD IF NOT EXISTS expires_at ON privacy_policy TYPE option<string>;
DEFINE FIELD IF NOT EXISTS updated_at ON privacy_policy TYPE string;
DEFINE TABLE IF NOT EXISTS phlio_note SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS author ON phlio_note TYPE string;
DEFINE FIELD IF NOT EXISTS object_id ON phlio_note TYPE option<string>;
DEFINE FIELD IF NOT EXISTS recipients ON phlio_note TYPE array<string>;
DEFINE FIELD IF NOT EXISTS room_id ON phlio_note TYPE option<string>;
DEFINE FIELD IF NOT EXISTS text ON phlio_note TYPE string;
DEFINE FIELD IF NOT EXISTS created_at ON phlio_note TYPE string;
DEFINE FIELD IF NOT EXISTS expires_at ON phlio_note TYPE option<string>;
DEFINE TABLE IF NOT EXISTS object_alias SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS provider ON object_alias TYPE string;
DEFINE FIELD IF NOT EXISTS external_id ON object_alias TYPE string;
DEFINE FIELD IF NOT EXISTS object_id ON object_alias TYPE string;
DEFINE TABLE IF NOT EXISTS graph_audit SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS requester ON graph_audit TYPE string;
DEFINE FIELD IF NOT EXISTS tool ON graph_audit TYPE string;
DEFINE FIELD IF NOT EXISTS purpose ON graph_audit TYPE string;
DEFINE FIELD IF NOT EXISTS scope ON graph_audit TYPE string;
DEFINE FIELD IF NOT EXISTS result_class ON graph_audit TYPE string;
DEFINE FIELD IF NOT EXISTS result_count ON graph_audit TYPE int;
DEFINE FIELD IF NOT EXISTS created_at ON graph_audit TYPE string;
DEFINE TABLE IF NOT EXISTS graph_outbox SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS event ON graph_outbox TYPE string;
DEFINE FIELD IF NOT EXISTS entity ON graph_outbox TYPE string;
DEFINE FIELD IF NOT EXISTS created_at ON graph_outbox TYPE string;
DEFINE FIELD IF NOT EXISTS delivered ON graph_outbox TYPE bool;
DEFINE TABLE IF NOT EXISTS graph_meta SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS value ON graph_meta TYPE int;
DEFINE TABLE IF NOT EXISTS friend TYPE RELATION IN user OUT user ENFORCED SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS status ON friend TYPE string;
DEFINE FIELD IF NOT EXISTS requested_by ON friend TYPE string;
DEFINE FIELD IF NOT EXISTS created_at ON friend TYPE string;
DEFINE FIELD IF NOT EXISTS accepted_at ON friend TYPE option<string>;
DEFINE INDEX IF NOT EXISTS friend_in ON friend FIELDS in;
DEFINE INDEX IF NOT EXISTS friend_out ON friend FIELDS out;
DEFINE TABLE IF NOT EXISTS follows TYPE RELATION IN user OUT user ENFORCED SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS created_at ON follows TYPE string;
DEFINE INDEX IF NOT EXISTS follows_in ON follows FIELDS in;
DEFINE INDEX IF NOT EXISTS follows_out ON follows FIELDS out;
DEFINE TABLE IF NOT EXISTS block TYPE RELATION IN user OUT user ENFORCED SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS created_at ON block TYPE string;
DEFINE FIELD IF NOT EXISTS reason_code ON block TYPE string;
DEFINE INDEX IF NOT EXISTS block_in ON block FIELDS in;
DEFINE INDEX IF NOT EXISTS block_out ON block FIELDS out;
DEFINE TABLE IF NOT EXISTS activity TYPE RELATION IN user OUT phlio_object ENFORCED SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS verb ON activity TYPE string;
DEFINE FIELD IF NOT EXISTS created_at ON activity TYPE string;
DEFINE FIELD IF NOT EXISTS visibility_class ON activity TYPE string;
DEFINE INDEX IF NOT EXISTS activity_in ON activity FIELDS in;
DEFINE INDEX IF NOT EXISTS activity_out ON activity FIELDS out;
DEFINE TABLE IF NOT EXISTS graph_member TYPE RELATION IN user OUT phlio_object ENFORCED SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS role ON graph_member TYPE string;
DEFINE FIELD IF NOT EXISTS created_at ON graph_member TYPE string;
DEFINE INDEX IF NOT EXISTS graph_member_in ON graph_member FIELDS in;
DEFINE INDEX IF NOT EXISTS graph_member_out ON graph_member FIELDS out;
DEFINE TABLE IF NOT EXISTS object_link TYPE RELATION IN phlio_object OUT phlio_object ENFORCED SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS kind ON object_link TYPE string;
DEFINE INDEX IF NOT EXISTS object_link_in ON object_link FIELDS in;
DEFINE INDEX IF NOT EXISTS object_link_out ON object_link FIELDS out;
DEFINE TABLE IF NOT EXISTS post SCHEMALESS PERMISSIONS NONE;
DEFINE TABLE IF NOT EXISTS comment SCHEMALESS PERMISSIONS NONE;
DEFINE TABLE IF NOT EXISTS room SCHEMALESS PERMISSIONS NONE;
DEFINE TABLE IF NOT EXISTS room_message SCHEMALESS PERMISSIONS NONE;
DEFINE TABLE IF NOT EXISTS product SCHEMALESS PERMISSIONS NONE;
DEFINE TABLE IF NOT EXISTS seller SCHEMALESS PERMISSIONS NONE;
DEFINE TABLE IF NOT EXISTS social_video SCHEMALESS PERMISSIONS NONE;
DEFINE TABLE IF NOT EXISTS liked TYPE RELATION SCHEMALESS PERMISSIONS NONE;
DEFINE TABLE IF NOT EXISTS saved TYPE RELATION SCHEMALESS PERMISSIONS NONE;
DEFINE TABLE IF NOT EXISTS member_of TYPE RELATION SCHEMALESS PERMISSIONS NONE;
DEFINE INDEX IF NOT EXISTS user_username_idx ON user FIELDS username UNIQUE;
DEFINE INDEX IF NOT EXISTS user_email_idx ON user FIELDS email UNIQUE;
DEFINE INDEX IF NOT EXISTS phlio_object_domain_idx ON phlio_object FIELDS platform, domain_ref UNIQUE;
DEFINE INDEX IF NOT EXISTS privacy_policy_lookup_idx ON privacy_policy FIELDS owner, platform, object_type, verb UNIQUE;
DEFINE INDEX IF NOT EXISTS activity_time_idx ON activity FIELDS created_at;
DEFINE INDEX IF NOT EXISTS activity_verb_idx ON activity FIELDS verb;
DEFINE INDEX IF NOT EXISTS post_author_idx ON post FIELDS author_id, created_at;
DEFINE INDEX IF NOT EXISTS social_video_creator_idx ON social_video FIELDS creator, created_at;
DEFINE INDEX IF NOT EXISTS object_alias_external_idx ON object_alias FIELDS provider, external_id UNIQUE;
UPSERT graph_meta:revision SET value = value ?? 0;

DEFINE TABLE IF NOT EXISTS book_listing SCHEMALESS PERMISSIONS NONE;
DEFINE TABLE IF NOT EXISTS booking SCHEMALESS PERMISSIONS NONE;
DEFINE TABLE IF NOT EXISTS platform_content SCHEMALESS PERMISSIONS NONE;
DEFINE TABLE IF NOT EXISTS graph_group SCHEMALESS PERMISSIONS NONE;
DEFINE TABLE IF NOT EXISTS graph_group_message SCHEMALESS PERMISSIONS NONE;
DEFINE INDEX IF NOT EXISTS content_platform ON platform_content FIELDS platform;
DEFINE INDEX IF NOT EXISTS group_message_group ON graph_group_message FIELDS group_id, created_at;

DEFINE TABLE IF NOT EXISTS shared_story SCHEMALESS PERMISSIONS NONE;
